# 텍스트 파일은 저장소에서 LF로 정규화 (Windows CRLF 경고 방지)
* text=auto eol=lf

# 바이너리 자산은 변환하지 않음
*.woff2 binary
*.woff  binary
*.ttf   binary
*.otf   binary
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.webp  binary
*.ico   binary
*.pdf   binary

# 윈도우 배치 파일은 CRLF 로 내려받아야 실행됩니다
*.bat   text eol=crlf
*.cmd   text eol=crlf
